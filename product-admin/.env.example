# Supabase 대시보드 → Project Settings 에서 복사해 = 뒤에 붙여 넣고 저장한다
# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채운다. 이 예시 파일에는 실제 값을 넣지 않는다
# Session pooler 등 DB 접속 문자열(postgresql://...)은 쓰지 않는다

# Data API → Project URL (예: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# API Keys → anon 또는 publishable 키 — 조회용, 브라우저에서 사용
VITE_SUPABASE_ANON_KEY=

# API Keys → service_role 또는 secret 키 — 추가 · 삭제용, 개발 서버에서만 사용
# VITE_ 를 붙이지 않는다 (붙이면 브라우저 코드에 들어가 노출됨)
SUPABASE_SERVICE_ROLE_KEY=
